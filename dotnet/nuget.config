<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <config>
    <!-- Every package must carry a valid signature. -->
    <add key="signatureValidationMode" value="require" />
  </config>

  <!-- Fingerprints are the SHA-256 of the signing certificates, taken from signed nuget.org
       packages. Microsoft and nuget.org have rotated certificates over the years, so each
       generation is pinned; the pin itself is the anchor (allowUntrustedRoot only relaxes the
       chain-root check for the older roots, e.g. VeriSign, absent from some trust stores). -->
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D" hashAlgorithm="SHA256" allowUntrustedRoot="false" owner="NuGet.org Repository by Microsoft" />
      <certificate fingerprint="5A2901D6ADA3D18260B9C6DFE2133C95D74B9EEF6AE0E5DC334C8454D1477DF4" hashAlgorithm="SHA256" allowUntrustedRoot="true" owner="NuGet.org Repository by Microsoft" />
      <certificate fingerprint="0E5F38F57DC1BCC806D8494F4F90FBCEDD988B46760709CBEEC6F4219AA6157D" hashAlgorithm="SHA256" allowUntrustedRoot="true" owner="NuGet.org Repository by Microsoft" />
    </repository>
    <author name="Microsoft" certificateFingerprint="9A1B131BEE0605433056A4EA3815478A8E177961A968C6C0027C1093D1FEB630">
      <certificate fingerprint="9A1B131BEE0605433056A4EA3815478A8E177961A968C6C0027C1093D1FEB630" hashAlgorithm="SHA256" allowUntrustedRoot="false" owner="Microsoft Corporation" />
      <certificate fingerprint="AA12DA22A49BCE7D5C1AE64CC1F3D892F150DA76140F210ABD2CBFFCA2C18A27" hashAlgorithm="SHA256" allowUntrustedRoot="true" owner="Microsoft Corporation" />
      <certificate fingerprint="3F9001EA83C560D712C24CF213C3D312CB3BFF51EE89435D3430BD06B5D0EECE" hashAlgorithm="SHA256" allowUntrustedRoot="true" owner="Microsoft Corporation" />
    </author>
  </trustedSigners>

</configuration>
