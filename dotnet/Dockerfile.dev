# Dev image for the Librarian hosts: the .NET 10 ASP.NET Core runtime plus curl, nothing else.
# infra/compose.yaml bind-mounts the host's build output over /app — the image carries no app.
FROM mcr.microsoft.com/dotnet/aspnet:10.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENTRYPOINT ["dotnet"]
CMD ["Librarian.Ingest.dll"]
