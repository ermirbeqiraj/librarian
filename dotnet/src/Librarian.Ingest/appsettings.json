{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Librarian": {
    "ScanIntervalSeconds": 30,
    "Folders": {
      "Inbox": "inbox",
      "Processed": "processed",
      "Results": "results",
      "Documents": "documents"
    }
  },
  "Ingest": {
    "Docling": {
      "Url": "http://127.0.0.1:5001",
      "TimeoutSeconds": 300
    },
    "Ocr": {
      "Url": "https://api.mistral.ai/v1/ocr",
      "Model": "mistral-ocr-latest",
      "MaxPages": 10,
      "MinCharsPerPage": 200,
      "CallLimit": 3,
      "HardLimit": 50,
      "TimeoutSeconds": 300
    },
    "Extract": {
      "BaseUrl": "https://api.mistral.ai/v1",
      "Model": "mistral-small-2603",
      "ReasoningEffort": "high",
      "MaxRounds": 5,
      "HeadPages": 5,
      "TailPages": 5
    }
  }
}
