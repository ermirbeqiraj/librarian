{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Librarian": {
    "ScanIntervalSeconds": 30,
    "Folders": {
      "Inbox": "inbox",
      "Processed": "processed",
      "Results": "results",
      "Documents": "documents",
      "Quarantine": "quarantine"
    }
  },
  "Ingest": {
    "MaxAttempts": 3,
    "Docling": {
      "Url": "http://127.0.0.1:5001",
      "TimeoutSeconds": 300
    },
    "Ocr": {
      "Url": "https://api.mistral.ai/v1/ocr",
      "Model": "mistral-ocr-latest",
      "MaxPages": 10,
      "MinCharsPerPage": 200,
      "TimeoutSeconds": 300
    },
    "Extract": {
      "BaseUrl": "https://api.mistral.ai/v1",
      "Model": "mistral-small-2603",
      "ReasoningEffort": "high",
      "MaxRounds": 5,
      "HeadPages": 5,
      "TailPages": 5,
      "ParseRetries": 2
    }
  },
  "Store": {
    "ScanIntervalSeconds": 30,
    "MaxTries": 3,
    "Embedding": {
      "Url": "http://127.0.0.1:8083",
      "Model": "BAAI/bge-m3",
      "Dimensions": 1024,
      "TokenBudget": 8176,
      "BatchSize": 32,
      "TimeoutSeconds": 300
    }
  }
}
