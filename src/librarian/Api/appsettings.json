{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Hosting": "Information"
    }
  },
  "AllowedHosts": "*",
  "Store": {
    "ScanIntervalSeconds": 30,
    "MaxTries": 3,
    "Embedding": {
      "Url": "http://127.0.0.1:8083",
      "Model": "BAAI/bge-m3",
      "Dimensions": 1024,
      "TokenBudget": 8176,
      "BatchSize": 32,
      "TimeoutSeconds": 300
    }
  },
  "Refine": {
    "BaseUrl": "https://api.mistral.ai/v1",
    "Model": "mistral-medium-2604",
    "ParseRetries": 2
  },
  "Librarian": {
    "ScanIntervalSeconds": 30,
    "Folders": {
      "Inbox": "inbox",
      "Processed": "processed",
      "Results": "results",
      "Documents": "documents"
    }
  },
  "Ask": {
    "BaseUrl": "https://api.mistral.ai/v1",
    "Model": "deepseek-v4-1-flash-1017",
    "ReasoningEffort": "high",
    "MaxRounds": 20,
    "Retention": {
      "Days": 15,
      "ScanMinutes": 60
    }
  }
}
