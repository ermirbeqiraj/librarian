<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Exact versions only. A bump is proven with "dotnet nuget verify" on all packages and goes on its own branch. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Abstractions" Version="1.28.0" />
