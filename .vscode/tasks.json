{
  // The dev services in infra/compose.yaml.
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}/infra",
    "shell": { "executable": "bash", "args": ["-c"] }
  },
  "presentation": { "reveal": "always", "clear": true },
  "tasks": [
    {
      "label": "dotnet: build",
      "detail": "Build the .NET solution; restore runs in locked mode",
      "type": "shell",
      "command": "dotnet build Librarian.slnx",
      "options": { "cwd": "${workspaceFolder}/dotnet" },
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: test",
      "detail": "Run the .NET tests",
      "type": "shell",
      "command": "dotnet test Librarian.slnx",
      "options": { "cwd": "${workspaceFolder}/dotnet" },
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: migrate",
      "detail": "EF Core migrations as their own host-side step against the compose Postgres; the connection string comes from the gitignored dev overlay — never on an app's start",
      "type": "shell",
      "command": "DOTNET_ENVIRONMENT=Development dotnet ef database update --project src/Librarian.Adapters --startup-project src/Librarian.Ingest",
      "options": { "cwd": "${workspaceFolder}/dotnet" },
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "librarian:evals: search vector",
      "detail": "The search eval in vector mode: embeds each question via TEI, scores the ranks",
      "type": "shell",
      "command": "dotnet run --project src/Librarian.Evals -- search --mode vector",
      "options": { "cwd": "${workspaceFolder}/dotnet" },
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "librarian:evals: search keyword",
      "detail": "The search eval in keyword mode: the tsquery side, scored on the same cases",
      "type": "shell",
      "command": "dotnet run --project src/Librarian.Evals -- search --mode keyword",
      "options": { "cwd": "${workspaceFolder}/dotnet" },
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "librarian:evals: refine",
      "detail": "The refine eval: every case through the query rewriter, query count and periods scored, the text printed",
      "type": "shell",
      "command": "dotnet run --project src/Librarian.Evals -- refine",
      "options": { "cwd": "${workspaceFolder}/dotnet" },
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "infra: up",
      "detail": "Start every service and wait until each is healthy",
      "type": "shell",
      "command": "docker compose up -d --wait --remove-orphans",
      "problemMatcher": []
    },
    {
      "label": "infra: stop",
      "detail": "Stop every service; the data stays",
      "type": "shell",
      "command": "docker compose stop",
      "problemMatcher": []
    },
    {
      "label": "infra: status",
      "detail": "Each service's state and health",
      "type": "shell",
      "command": "docker compose ps -a",
      "problemMatcher": []
    },
    {
      "label": "infra: logs",
      "detail": "Follow one service's log",
      "type": "shell",
      "command": "docker compose logs -f --tail 200 ${input:service}",
      "problemMatcher": []
    },
    {
      "label": "infra: reset",
      "detail": "Start fresh: an empty Postgres, new containers; keeps the downloaded model",
      "type": "shell",
      "command": "[ '${input:confirmReset}' = yes ] || { echo 'Cancelled.'; exit 0; }; docker compose down --remove-orphans && docker volume rm -f librarian_pgdata && docker compose up -d --wait",
      "problemMatcher": []
    },
    {
      "label": "postgres: restart",
      "detail": "A new container on the same data",
      "type": "shell",
      "command": "docker compose up -d --wait --force-recreate postgres",
      "problemMatcher": []
    },
    {
      "label": "postgres: wipe",
      "detail": "Delete every database and start an empty one, with only the extensions",
      "type": "shell",
      "command": "[ '${input:confirmWipe}' = yes ] || { echo 'Cancelled.'; exit 0; }; docker compose rm -sf postgres && docker volume rm -f librarian_pgdata && docker compose up -d --wait postgres",
      "problemMatcher": []
    },
    {
      "label": "docling: restart",
      "detail": "A new container; docling keeps nothing",
      "type": "shell",
      "command": "docker compose up -d --wait --force-recreate docling",
      "problemMatcher": []
    },
    {
      "label": "bge-m3: restart",
      "detail": "A new container; the model stays downloaded",
      "type": "shell",
      "command": "docker compose up -d --wait --force-recreate bge-m3",
      "problemMatcher": []
    },
    {
      "label": "app: ingest restart",
      "detail": "Recreate the ingest container on the mounted build output; the restart re-scans the inbox",
      "type": "shell",
      "command": "docker compose up -d --wait --force-recreate ingest",
      "problemMatcher": []
    },
    {
      "label": "app: api restart",
      "detail": "Recreate the api container on the mounted build output",
      "type": "shell",
      "command": "docker compose up -d --wait --force-recreate api",
      "problemMatcher": []
    },
    {
      "label": "app: ingest build+restart",
      "detail": "Host build, then recreate the ingest container — one task, no image rebuild",
      "type": "shell",
      "command": "cd ../dotnet && dotnet build Librarian.slnx && cd ../infra && docker compose up -d --wait --force-recreate ingest",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "app: api build+restart",
      "detail": "Host build, then recreate the api container — one task, no image rebuild",
      "type": "shell",
      "command": "cd ../dotnet && dotnet build Librarian.slnx && cd ../infra && docker compose up -d --wait --force-recreate api",
      "problemMatcher": "$msCompile"
    }
  ],
  "inputs": [
    {
      "id": "service",
      "type": "pickString",
      "description": "Which service?",
      "options": ["postgres", "docling", "bge-m3", "ingest", "api"]
    },
    {
      "id": "confirmWipe",
      "type": "pickString",
      "description": "Delete the dev databases (librarian, librarian_test)? Re-ingesting costs time and paid calls.",
      "options": ["no", "yes"],
      "default": "no"
    },
    {
      "id": "confirmReset",
      "type": "pickString",
      "description": "Reset everything? The dev databases are deleted.",
      "options": ["no", "yes"],
      "default": "no"
    }
  ]
}
